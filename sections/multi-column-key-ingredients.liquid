{%- liquid
  assign background_exists = true
  if section.settings.background_color == blank or section.settings.background_color == 'rgba(0,0,0,0)'
    assign background_exists = false
  endif

  assign key_ingredients_refs = product.metafields.custom.key_ingredients.value
  assign key_ingredients_count = 0

  comment
    key_ingredients_count determines how many columns to display (desktop), as well as the image size for each ingredient.
    The original section allowed up to 6 columns, the current design only supports either 2 or 3 columns.
    In case of additional ingredients being added in the future, make sure to limit the number of columns and set the image size accordingly.
  endcomment
  if key_ingredients_refs != blank
    assign key_ingredients_count = key_ingredients_refs.size
  endif

  assign render_key_ingredients = false
  if key_ingredients_count == 2 or key_ingredients_count == 3
    assign render_key_ingredients = true
  endif

  assign ingredient_image_width_ratio = 1.0
-%}

{%- capture ingredient_image_sizes -%}
  (min-width: 720px) calc(calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw))) / {{ key_ingredients_count }} * {{ ingredient_image_width_ratio }}), calc(100vw - calc(2 * 3.3vw))
{%- endcapture -%}

{% if render_key_ingredients %}
<div
  data-section-id="{{ section.id }}"
  data-section-type="multi-column"
  data-slider-on-mobile="{{ section.settings.enable_slider_mobile }}"
  data-mobile-columns-per-view="{{ section.settings.columns_mobile }}"
  class="
    multi-column
    {% if section.settings.background_behind_columns and background_exists %}
      multi-column--background-behind-column
    {% endif %}
    multi-column--intro-alignment-{{ section.settings.heading_alignment }}
    multi-column--column-content-alignment-desktop-{{ section.settings.column_alignment }}
    multi-column--column-content-alignment-mobile-{{ section.settings.column_alignment_mobile }}
    multi-column--column-content-vertical-alignment-{{ section.settings.content_vertical_alignment }}
    multi-column--column-content-padding-{{ section.settings.content_background_padding }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--multi-column
    {% endif %}
  "
  style="
    --color-text: {{ section.settings.text_color }};
    --color-section-background: {{ section.settings.background_color }};
    --grid-columns-desktop: {{ key_ingredients_count }};
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
    --grid-gap-column-desktop: {{ section.settings.column_spacing }}px;
    --grid-gap-column-mobile: {{ section.settings.column_spacing_mobile }}px;
    --grid-gap-row-desktop: {{ section.settings.row_spacing }}px;
    --grid-gap-row-mobile: {{ section.settings.row_spacing_mobile }}px;
    {% render 'overlay-button-vars', color_button_text: section.settings.button_text_color, color_button_background: section.settings.button_background_color %}
  "
>
  <div
    class="
      multi-column__inner
      section
      {{ section.settings.section_padding }}
      section--divider-{{ section.settings.divider_style }}
      carousel
      swiper
    "
  >
    <div class="multi-column__introduction section-introduction animation--section-introduction">
      {% unless section.settings.title == blank %}
        <{{ section.settings.heading_tag }} class="multi-column__heading section-introduction__heading ff-heading {{ section.settings.heading_font_class }}">
          {{ section.settings.title }}
        </{{ section.settings.heading_tag }}>
      {% endunless %}

      {% unless section.settings.subheading == blank %}
        <div class="multi-column__subheading section-introduction__subheading rte ff-body fs-body-100">
          {{ section.settings.subheading }}
        </div>
      {% endunless %}
    </div>
    <div class="multi-column__grid carousel__wrapper swiper-wrapper">
      {% comment %}
      {%- for block in section.blocks -%}
        {%- render 'multi-column-item', block: block, columns: section.settings.columns -%}
      {%- endfor -%}
      {% endcomment %}
      {% for ingredient in key_ingredients_refs %}
        <div class="multi-column__grid-item carousel__slide swiper-slide">
          <div class="multi-column__grid-item-inner">
            <figure
              class="multi-column__grid-item-image-figure"
              data-image-crop-circle="false"
              style="--image-max-width: 100%;"
            >
              <div class="multi-column__grid-item-image-wrapper">
                {%- render 'image',
                  wrapper_class: 'multi-column__grid-item-image',
                  image: ingredient.image.value,
                  sizes: ingredient_image_sizes,
                  aspect_ratio: 'square',
                  focal_point: 'image_presentation',
                  include_placeholder: true
                -%}
              </div>
            </figure>

            {% unless ingredient.name.value == blank and ingredient.description.value == blank %}
              <div class="multi-column__grid-item-text-container">
                {% unless ingredient.accent.value == blank %}
                  <p class="multi-column__grid-item-accent fs-accent">
                    {{ ingredient.accent.value }}
                  </p>
                {% endunless %}
                {% unless ingredient.name.value == blank %}
                  <h3 class="multi-column__grid-item-heading ff-heading fs-heading-3-base">
                    {{ ingredient.name.value }}
                  </h3>
                {% endunless %}

                {% unless ingredient.description.value == blank %}
                  <div
                    class="multi-column__grid-item-text ff-body fs-body-75 rte"
                    style="--text-max-width: 100%;"
                  >
                    {{ ingredient.description.value | newline_to_br }}
                  </div>
                {% endunless %}
              </div>
            {% endunless %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

