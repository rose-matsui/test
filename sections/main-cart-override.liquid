<script>
  window.minimumEngravingCartSubtotal = {{ section.settings.minimum_engraving_cart_subtotal }};

  const scrubVariantIds = [];

  {% for item in cart.items %}
    {% assign addon = item.product.metafields.custom.product_option_addon.value %}
    {% if addon %}
      scrubVariantIds.push({{ item.variant_id }});
    {% endif %}
  {% endfor %}

  // **************************************************
  // --- Cart validation ---
  // **************************************************
  async function validateCart() {
    const res = await fetch('/cart.js');
    const cart = await res.json();
    if (!cart || !cart.items.length) return false;

    const sampleVariantIds = window.sampleVariantIds || new Set();

    // --- Spoon count check ---
    let scrubCount = 0;
    cart.items.forEach(item => {
      if (scrubVariantIds.includes(item.variant_id)) scrubCount += item.quantity;
    });

    const spoonItems = cart.items.filter(item => item.product_type === 'Scrub Spoon');
    let totalSpoonQty = 0;
    let freeSpoonItem = null;
    spoonItems.forEach(item => {
      totalSpoonQty += item.quantity;
      if (item.final_line_price === 0 && !freeSpoonItem) freeSpoonItem = item;
    });

    if (freeSpoonItem && freeSpoonItem.quantity > scrubCount) {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id: freeSpoonItem.key, quantity: scrubCount })
      });
      window.location.reload();
      return true;
    }

    // --- Engraving removal if cart total < minimum engraving cart subtotal ---
    if (cart.total_price < window.minimumEngravingCartSubtotal * 100) {
      const engravingFixes = cart.items.map(item => {
        const props = item.properties || {};
        const hasEngraving = props.engraving_line_1 || props.engraving_line_2;
        if (!hasEngraving) return null;

        const newProps = { ...props };
        delete newProps.engraving_line_1;
        delete newProps.engraving_line_2;
        newProps._placeholder = '';

        return fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: item.key, quantity: item.quantity, properties: newProps })
        });
      }).filter(Boolean);

      if (engravingFixes.length) {
        await Promise.all(engravingFixes);
        window.location.reload();
        return true;
      }
    }

    // --- Gift wrap sync ---
    const wrappingMap = new Map();
    const variantIdToItemMap = new Map();

    cart.items.forEach(item => {
      if (item.properties?.wrapped_item) {
        const wrappedVariantId = Number(item.properties.wrapped_item);
        wrappingMap.set(wrappedVariantId, item);
      } else {
        variantIdToItemMap.set(item.variant_id, item);
      }
    });

    for (const [wrappedVariantId, wrappingItem] of wrappingMap.entries()) {
      const mainStillExists = variantIdToItemMap.has(wrappedVariantId);
      if (!mainStillExists) {
        await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: wrappingItem.key, quantity: 0 })
        });
        window.location.reload();
        return true;
      }
    }

    for (const item of cart.items) {
      if (!item.properties?.wrapped_item) {
        const wrappedVariantId = item.variant_id;
        const wrappingItem = wrappingMap.get(wrappedVariantId);
        if (wrappingItem && wrappingItem.quantity !== item.quantity) {
          await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ id: wrappingItem.key, quantity: item.quantity })
          });
          window.location.reload();
          return true;
        }
      }
    }

    // --- Check if only disposable items remain (i.e. no main items in the cart) ---
    const onlyDisposableItems = cart.items.every((item) => {
      const isSample = sampleVariantIds.has(item.variant_id);
      const isSpoon = item.product_type === 'Scrub Spoon';
      const isGift = item.product_type === 'Gift';
      const isWrapping = !!item.properties?.wrapped_item;
      const isGiftBag =
        item.handle === 'ペーパーバッグ' ||
        item.handle === 'paper_bag';

      return isSample || isSpoon || isGift || isWrapping || isGiftBag;
    });

    if (onlyDisposableItems && cart.items.length > 0) {
      await Promise.all(cart.items.map(item =>
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: item.key, quantity: 0 })
        })
      ));
      window.location.reload();
      return true;
    }

    // If no changes made, mark cart as clean
    localStorage.setItem("cartIsClean", "true");
    return false;
  }

  document.addEventListener('DOMContentLoaded', async () => {
    if (localStorage.getItem("cartIsClean") === "true") return;
    await validateCart();
  });

  document.addEventListener("cart:updated", () => {
    localStorage.removeItem("cartIsClean");
    window.location.reload();
  });
</script>

<div
  class="cart page"
  data-section-id="{{ section.id }}"
  data-section-type="cart"
>
  <div class="cart__container page__cart-inner">
    {%- if cart.item_count >= 1 -%}
      <form action="{{ routes.cart_url }}" method="post" data-form novalidate class="cart__form">
        <div class="cart__form-items" js-cart-items>
          {% render 'cart-back-button' %}

          <div class="cart__top-area">
            {% if section.settings.enable_marketing_message %}
              <div class="cart__marketing-message">
                {{ section.settings.marketing_message }}
              </div>
            {% endif %}
          </div>
          <div class="cart__form-header">
            <h1 class="section-header__title cart__form-header-title">{{ 'cart.general.title' | t }}</h1>
            <span class="cart__form-item-count fs-body-100">
              {{- 'cart.general.items_with_count' | t: count: cart.item_count -}}
            </span>
          </div>

          {% assign threshold = section.settings.minimum_engraving_cart_subtotal | times: 100 %}
          {% assign min_price_engraving = false %}
          {% if cart.total_price >= threshold %}
            {% assign min_price_engraving = true %}
          {% endif %}

          {% assign engraved_key = blank %}
          {% for item in cart.items %}
            {% if item.properties.engraving_line_1 != blank or item.properties.engraving_line_2 != blank %}
              {% assign engraved_key = item.key %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% comment %} assign spoon variant ids {% endcomment %}
          {% assign spoon_variant_ids = '' %}
          {% for product in metaobjects.addon.scrub_spoon.products.value %}
            {% assign variant_id = product.variants.first.id %}
            {% assign spoon_variant_ids = spoon_variant_ids | append: variant_id | append: ',' %}
          {% endfor %}
          {% assign spoon_variant_ids_array = spoon_variant_ids | split: ',' %}

          {%- for item in cart.items -%}

            {% assign is_free_sample = false %}
            {% assign item_variant_id_str = item.variant_id | append: '' %}
            {% assign is_wrapping = false %}
            {% assign is_gift = false %}
            
            {% if item.properties.wrapped_item != blank %}
              {% assign is_wrapping = true %}
            {% endif %}

            {% if item.product.type == 'Gift' %}
              {% assign is_gift = true %}
            {% endif %}
            
            {% comment %} check if item is free sample {% endcomment %}
            {% for collection in item.product.collections %}
              {% if collection.handle == 'free-samples' %}
                {% assign is_free_sample = true %}
              {% endif %}
            {% endfor %}

            {% unless is_free_sample or is_wrapping or spoon_variant_ids_array contains item_variant_id_str or is_gift %}
              <div class="cart__form-item" data-input-item data-id="{{ item.id }}" data-key="{{ item.key }}">
                <div class="cart__form-item-image">
                  <a href="{{ item.url }}" class="cart__form-item-link">
                    {%-
                      render 'image' with
                      image: item.image,
                      sizes: "120px",
                      prioritize_loading: true
                      aspect_ratio: settings.cart_item_aspect_ratio,
                      include_placeholder: true
                    -%}
                  </a>
                </div>
                <div class="cart__form-item-details-wrapper">
                  <div class="cart__form-item-details">
                    <div class="cart__form-item-info-wrapper">
                      <div class="cart__form-item-info">
                        <h4 class="cart__form-item-title fs-product-card-title">
                          <a href="{{ item.url }}">{{ item.product.title }}</a>
                        </h4>

                        {% unless item.product.has_only_default_variant %}
                          <p class="cart__form-item-variant fs-body-50 t-opacity-60">{{ item.variant.title }}</p>
                        {% endunless %}

                        {% if item.selling_plan_allocation %}
                          <p class="cart__form-item-subscriptions fs-body-50 t-opacity-60">
                            {{ item.selling_plan_allocation.selling_plan.name }}
                          </p>
                        {% endif %}

                        {%- assign property_size = item.properties | size -%}

                        {% if property_size > 0 %}
                          <div class="cart__form-item-properties fs-body-60 t-opacity-80">
                            {% for p in item.properties %}
                              {% # Don't show property if property name begins with an underscore, or if property is blank, or if it's an engraving line. %}
                              {% assign first_char = p.first | slice: 0 %}
                              {% unless p.last == blank or first_char == '_' or p.first == 'engraving_line_1' or p.first == 'engraving_line_2' or p.first == 'engraving_line_3' %}
                                <p>
                                  {{ p.first }}:
                                  {% if p.last contains '/uploads/' %}
                                    <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                                  {% else %}
                                    {{ p.last }}
                                  {% endif %}
                                </p>
                              {% endunless %}
                            {% endfor %}
                          </div>
                        {% endif %}

                        {% if item.line_level_discount_allocations.size > 0 %}
                          <ul class="cart__form-item-discounts">
                            {% for discount_allocation in item.line_level_discount_allocations %}
                              <li class="cart__form-item-discount fs-body-75">
                                {%- render 'icon' with icon: 'discount-badge' -%}
                                {{ discount_allocation.discount_application.title }} (-
                                {{- discount_allocation.amount | money -}}
                                )
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>

                      <div class="cart__form-item-price-wrapper-mobile">
                        {% liquid
                          assign price_content_type = 'price'
  
                          if item.original_price == 0 and settings.zero_dollar_cart_price_display == 'replace'
                            assign price_content_type = 'custom'
                          endif
  
                          assign item_price = item.original_price
                          assign item_sale_price = blank
                          assign price_tag_type = 'span'
  
                          if item.original_line_price > item.final_line_price or item.variant.compare_at_price > item.variant.price
                            assign price_tag_type = 's'
  
                            if item.original_line_price > item.final_line_price
                              assign item_sale_price = item.final_price
                            else
                              assign item_price = item.variant.compare_at_price
                              assign item_sale_price = item.original_price
                            endif
                          endif
  
                          if section.settings.show_product_currency
                            capture iso_code
                              echo cart.currency.iso_code
                            endcapture
                          endif
                        %}
  
                        {% # Compare check allows for sale items to properly show instead of being replaced by text %}
                        {% if price_content_type == 'price' or item.variant.compare_at_price > item.original_price %}
                          <div class="cart__form-item-price-wrapper fs-body-75">
                            <{{ price_tag_type }} class="cart__form-item-price">
                              {{- item_price | money -}}
                              {% if item_sale_price == blank %}
                                <span class="cart__form-item-price-tax-included">{{ 'cart.general.tax_included' | t }}</span>
                              {% endif %}
                            </{{ price_tag_type }}>
  
                            {%- if item_sale_price != blank -%}
                              <div class="cart__form-item-price sale-price">
                                {{- item_sale_price | money -}}
                                <span class="cart__form-item-price-tax-included sale">{{ 'cart.general.tax_included' | t }}</span>
                              </div>
                            {%- endif -%}
  
                            {% render 'unit-price', item: item %}
                          </div>
  
                        {% elsif price_content_type == 'custom' %}
                          <div class="cart__form-item-price-wrapper fs-body-75">
                            <span class="cart__form-item-price">
                              {{ 'products.inventory.zero_price_custom_label' | t }}
                            </span>
                          </div>
                        {% endif %}
                      </div>
                    </div>

                    <div class="cart__form-item-quantity-wrapper">
                      <p class="cart__form-item-error fs-body-50 hidden">{{ 'cart.general.error' | t }}</p>

                      {% comment %} Low inventory warning {% endcomment %}
                      {%- if settings.enable_low_inventory_warning -%}
                        {%- liquid
                          assign item_variants = item.product.variants
                          assign item_variant = item_variants | where: 'id', item.id | first
                        -%}

                        {%- if item_variant.inventory_management != blank
                          and item_variant.inventory_policy == 'deny'
                          and item_variant.inventory_quantity < settings.low_inventory_warning_threshold
                        -%}
                          <p class="cart__inventory-warning fs-body-50">
                            {{ 'cart.general.inventory_warning' | t: amount: item_variant.inventory_quantity }}
                          </p>
                        {%- endif -%}
                      {%- endif -%}

                      <div class="cart__form-item-quantity-container">
                 {%- render 'quantity-input',
                          id: item.id,
                          initial_value: item.quantity,
                          enable_purchase_limit: item.product.metafields.custom.enable_purchase_limit.value,
                          max_purchase_quantity: item.product.metafields.custom.max_purchase_quantity.value,
                          product_metafields: item.product.metafields
                        -%}
                        <div class="cart__form-item-remove-mobile">
                          <button
                            type="button"
                            data-remove-item
                            class="cart__form-item-remove fs-body-75 t-subdued btn btn--text-link"
                          >
                            {{ 'cart.general.remove' | t }}
                          </button>
                        </div>
                      </div>
                    </div>

                    {% assign gift_wrapping = item.product.metafields.custom.product_option_gift_wrapping.value %}

                    {% if gift_wrapping != blank %}

                      {% assign gift_wrapping_product_variant = gift_wrapping.product_variant.value %}
                      {% if gift_wrapping_product_variant != blank and gift_wrapping_product_variant.barcode != blank %}

                      {%- assign already_wrapped = false -%}
                      {% assign item_id_string = item.id | append: '' %}

                      {%- for cart_item in cart.items -%}
                        {% if cart_item.properties.wrapped_item and cart_item.properties.wrapped_item == item_id_string %}
                          {% assign already_wrapped = true %}
                        {% endif %}
                      {%- endfor -%}

                      <div class="cart__form-item-gift-wrapping-area">
                        <p class="fs-body-75 cart__form-item-gift-wrapping-label">
                          {{ 'cart.gift_wrapping.select_wrapping' | t }}
                        </p>
                        <div class="cart__form-item-gift-wrapping-wrapper">
                          <select
                            class="input fs-body-75 filter-group__label cart__form-item-gift-wrapping-select"
                            data-gift-wrapping-variant-id="{{ item.variant_id }}"
                            data-gift-wrapping-quantity="{{ item.quantity }}"
                            data-gift-wrapping-barcode="{{ gift_wrapping_product_variant.barcode }}"
                          >
                            <option value="">{{ 'cart.gift_wrapping.no_wrapping' | t }}</option>
                            <option value="{{ gift_wrapping_product_variant.id }}" {% if already_wrapped %}selected{% endif %}>{{ gift_wrapping_product_variant.product.title }} {{ gift_wrapping.size }} ({{ gift_wrapping_product_variant.price | money }}{% if item.quantity > 1 %} x{{ item.quantity }}{% endif %})</option>
                          </select>
                          <div class="cart__form-item-gift-wrapping-arrow">
                            <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M10.4507 0.665412C10.5289 0.588207 10.6344 0.544922 10.7444 0.544922C10.8543 0.544922 10.9598 0.588207 11.0381 0.665412C11.0766 0.703376 11.1072 0.748628 11.1281 0.798535C11.149 0.848442 11.1598 0.902007 11.1598 0.956112C11.1598 1.01022 11.149 1.06378 11.1281 1.11369C11.1072 1.1636 11.0766 1.20885 11.0381 1.24681L6.29327 5.94481C6.21502 6.02202 6.10951 6.0653 5.99957 6.0653C5.88964 6.0653 5.78413 6.02202 5.70587 5.94481L0.961073 1.24681C0.922523 1.20885 0.891909 1.1636 0.871013 1.11369C0.850117 1.06378 0.839355 1.01022 0.839355 0.956112C0.839355 0.902007 0.850117 0.848442 0.871013 0.798535C0.891909 0.748628 0.922523 0.703376 0.961073 0.665412C1.03933 0.588207 1.14484 0.544922 1.25477 0.544922C1.3647 0.544922 1.47022 0.588207 1.54847 0.665412L5.99987 4.95001L10.4507 0.665412Z" fill="#B3975F"/>
                            </svg>
                          </div>
                        </div>
                      </div>
                      {% endif %}
                    {% endif %}

                  </div>
                  <div class="cart__form-item-price-wrapper-pc">
                    {% liquid
                      assign price_content_type = 'price'

                      if item.original_price == 0 and settings.zero_dollar_cart_price_display == 'replace'
                        assign price_content_type = 'custom'
                      endif

                      assign item_price = item.original_price
                      assign item_sale_price = blank
                      assign price_tag_type = 'span'

                      if item.original_line_price > item.final_line_price or item.variant.compare_at_price > item.variant.price
                        assign price_tag_type = 's'

                        if item.original_line_price > item.final_line_price
                          assign item_sale_price = item.final_price
                        else
                          assign item_price = item.variant.compare_at_price
                          assign item_sale_price = item.original_price
                        endif
                      endif

                      if section.settings.show_product_currency
                        capture iso_code
                          echo cart.currency.iso_code
                        endcapture
                      endif
                    %}

                    {% # Compare check allows for sale items to properly show instead of being replaced by text %}
                    {% if price_content_type == 'price' or item.variant.compare_at_price > item.original_price %}
                      <div class="cart__form-item-price-wrapper fs-body-75">
                        <{{ price_tag_type }} class="cart__form-item-price">
                          {{- item_price | money -}}
                          {% if item_sale_price == blank %}
                            <span class="cart__form-item-price-tax-included">{{ 'cart.general.tax_included' | t }}</span>
                          {% endif %}
                        </{{ price_tag_type }}>

                        {%- if item_sale_price != blank -%}
                          <div class="cart__form-item-price sale-price">
                            {{- item_sale_price | money -}}
                            <span class="cart__form-item-price-tax-included sale">{{ 'cart.general.tax_included' | t }}</span>
                          </div>
                        {%- endif -%}

                        {% render 'unit-price', item: item %}
                      </div>

                    {% elsif price_content_type == 'custom' %}
                      <div class="cart__form-item-price-wrapper fs-body-75">
                        <span class="cart__form-item-price">
                          {{ 'products.inventory.zero_price_custom_label' | t }}
                        </span>
                      </div>
                    {% endif %}

                    <div class="cart__form-item-remove-pc">
                      <button
                        type="button"
                        data-remove-item
                        class="cart__form-item-remove fs-body-75 t-subdued btn btn--text-link"
                      >
                        {{ 'cart.general.remove' | t }}
                      </button>
                    </div>

                    <div class="cart__form-item-dummy-pc"></div>
                  </div>
                </div>
                {% comment %} Engraving Button {% endcomment %}
                {% assign engraving_option = item.product.metafields.custom.product_option_engraving.value %}
                {% if engraving_option != blank %}
                  <div class="line-item-engraving-block">
                    <div class="engraving-text">
                      <p class="fs-body-bold fs-body-75">
                        {% if min_price_engraving == false %}
                          {% assign formatted_price = section.settings.minimum_engraving_cart_subtotal %}
                          {{ 'cart.engraving.price_requirement' | t: minimum_cart_subtotal: formatted_price }}
                        {% elsif engraved_key != blank and engraved_key != item.key %}
                          {{ 'cart.engraving.other_item_engraved' | t }} 
                        {% elsif engraved_key != item.key %}
                          {{ 'cart.engraving.one_item_notice' | t }} 
                        {% elsif engraved_key == item.key %}
                          {{ 'cart.engraving.line_item_title' | t }} 
                        {% endif %}
                      </p>
                      <p class="fs-body-75"> {{ item.properties.engraving_line_1 }} </p>
                      <p class="fs-body-75"> {{ item.properties.engraving_line_2 }} </p>
                      <p class="fs-body-75"> {{ item.properties.engraving_line_3 }} </p>
                    </div>
                    {% if min_price_engraving == true %}
                      {% if engraved_key == blank or engraved_key == item.key %}
                        <button
                          type="button"
                          class="btn btn--primary fs-body-75"
                          data-custom-modal-open
                          data-engraving-key="{{ item.key }}"
                          data-engraving-option="{{ engraving_option }}"
                          data-properties='{{ item.properties | json }}'
                          data-product-quantity='{{ item.quantity }}'
                        >
                          {% if engraved_key == blank %}
                            {{ 'cart.engraving.add_engraving' | t }}
                          {% elsif engraved_key == item.key %}
                            {{ 'cart.engraving.edit_engraving' | t }}
                          {% endif %}
                        </button>
                      {% endif %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endunless %}
          {%- endfor -%}

          {% comment %} GIFT ITEMS {% endcomment %}
          {%- for item in cart.items -%}
            {% if item.product.type == 'Gift' %}
              <div class="cart__form-item cart__form-item--gift" data-input-item data-id="{{ item.id }}" data-key="{{ item.key }}">
                <div class="cart__form-item-image">
                  <a href="{{ item.url }}" class="cart__form-item-link">
                    {%-
                      render 'image' with
                      image: item.image,
                      sizes: "120px",
                      prioritize_loading: true
                      aspect_ratio: settings.cart_item_aspect_ratio,
                      include_placeholder: true
                    -%}
                  </a>
                </div>
                <div class="cart__form-item-details-wrapper">
                  <div class="cart__form-item-details">
                    <div class="cart__form-item-info-wrapper">
                      <div class="cart__form-item-info">
                        <h4 class="cart__form-item-title fs-product-card-title">
                          <a href="{{ item.url }}">{{ item.product.title }}</a>
                        </h4>
                        <p class="cart__form-item-gift-label">{{ 'cart.general.present' | t }}</p>
                      </div>
                    </div>

                    <div class="cart__form-item-quantity-wrapper-gift">
                      <div class="cart__form-item-quantity-container">
                        <span>{{ 'cart.general.quantity_times' | t }}{{ item.quantity }}</span>
                        <div class="cart__form-item-remove-mobile">
                          <button
                            type="button"
                            data-remove-item
                            class="cart__form-item-remove fs-body-75 t-subdued btn btn--text-link"
                          >
                            {{ 'cart.general.remove' | t }}
                          </button>
                        </div>
                      </div>
                    </div>

                  </div>
                  <div class="cart__form-item-price-wrapper-pc">
                    <div class="cart__form-item-dummy-pc"></div>
                
                    <div class="cart__form-item-remove-pc">
                      <button
                        type="button"
                        data-remove-item
                        class="cart__form-item-remove fs-body-75 t-subdued btn btn--text-link"
                      >
                        {{ 'cart.general.remove' | t }}
                      </button>
                    </div>

                    <div class="cart__form-item-dummy-pc"></div>
                  </div>
                </div>
              </div>
            {% endif %}
          {%- endfor -%}

          {% render 'cart-product-options',
            section_title: section.settings.section_title_options,
          %}
          {% render 'cart-gift-options',
            section_title: section.settings.section_title_gift_options,
          %}
          {% render 'cart-free-samples',
            section_title: section.settings.section_title,
            cart_free_samples_collection: section.settings.cart_free_samples_collection,
            minimum_cart_subtotal: section.settings.minimum_cart_subtotal,
            counter_text: section.settings.counter_text
          %}
          {%- if section.settings.cross_sells_position == 'below-line-items' -%}
            {%- render 'cross-sells', cart: cart, cart_items: cart.items -%}
          {%- endif -%}
        </div>

        <div class="cart__footer-wrapper">
          <div class="cart__footer">
            {%- if section.settings.show_cart_push -%}
              {%-
                render 'cart-push',
                cart_push_banner: section.settings.cart_push_banner,
                cart_push_text: section.settings.cart_push_text,
              -%}
            {%- endif -%}
            {%- render 'free-shipping-bar' %}

            <div class="cart__footer-inner">
              {%- if settings.show_cart_notes -%}
                <div class="cart__footer-order-note-wrapper" aria-expanded="false" aria-hidden="true">
                  <button
                    type="button"
                    class="cart__footer-order-note-trigger fs-body-75 btn btn--text-link"
                    data-order-note-trigger
                  >
                    <div class="cart__footer-order-note-trigger-icons">
                      {% render 'icon', with icon: 'plus-small' %}
                      {% render 'icon', with icon: 'minus-small', class: 'hidden' %}
                    </div>
                    <span class="cart__footer-order-note-trigger-text" data-cart-not-trigger-text>
                      {{ 'cart.general.order_note_button_add' | t }}
                    </span>
                  </button>
                  <div class="cart__footer-order-note-input" cart-note-input>
                    <label for="CartSpecialInstructions" class="fs-body-100">
                      {{- 'cart.general.order_note_label' | t -}}
                    </label>
                    <textarea
                      name="note"
                      id="CartSpecialInstructions"
                      style="background-color: var(--color-background);"
                      class="input"
                      placeholder="{{ 'cart.general.order_note_placeholder' | t }}"
                    >{{ cart.note }}</textarea>
                  </div>
                </div>
              {%- endif -%}

              <div
                class="cart__footer-subtotal-wrapper {% if  cart.cart_level_discount_applications.size > 0 %}cart__footer-subtotal-wrapper--has-discount{% endif %}"
                js-cart-footer-subtotal-wrapper
              >
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="cart__item-discounts">
                    {% for discount_application in cart.cart_level_discount_applications %}
                      <li class="cart__item-discount fs-body-75">
                        {%- render 'icon' with icon: 'discount-badge' -%}
                        {{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})
                      </li>
                    {% endfor %}
                  </ul>
                {%- endif -%}

                <div class="cart__footer-subtotal">
                  <h3 class="ff-body fs-body-200">{{ 'cart.general.subtotal' | t }}</h3>
                  <div class="cart__footer-subtotal-tax-wrapper">
                    <span class="cart__footer-subtotal-tax-label">
                      {{ 'cart.general.tax_included_simple' | t }}
                    </span>
                    <span class="ff-body fs-body-200 cart__footer-subtotal-tax-amount">
                      {{- cart.total_price | money -}}
                      {%- if section.settings.show_product_currency %}{% endif -%}
                    </span>
                  </div>
                </div>
              </div>

              <div class="cart__input-buttons">
                <button
                  type="submit"
                  name="update"
                  class="cart__update btn btn--secondary btn--full"
                  aria-label="{{ 'cart.general.update' | t }}"
                >
                  {{ 'cart.general.update' | t }}
                </button>
                <button
                  type="submit"
                  name="checkout"
                  class="cart__submit btn btn--full btn--primary"
                  aria-label="{{ 'cart.general.checkout' | t }}"
                >
                  {{ 'cart.general.checkout' | t }}
                </button>
                {% render 'sticky-checkout-cta' %}
              </div>

              {%- if additional_checkout_buttons -%}
                <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </div>
            {%- if section.settings.cross_sells_position == 'below-subtotal' -%}
              {%- render 'cross-sells',
                cart: cart,
                cart_items: cart.items,
                position: section.settings.cross_sells_position
              -%}
            {%- endif -%}
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart__empty">
        {% comment %}
          Cart empty state
        {% endcomment %}
        <div class="cart__empty-message supports-cookies">
          <h1 class="cart__empty-message-heading ff-heading fs-heading-2-base">{{ 'cart.general.empty' | t }}</h1>
          <p class="cart__empty-message-text fs-body-100">{{ 'cart.general.empty_message' | t }}</p>
          {%- assign empty_label = 'cart.general.continue_shopping' | t -%}
          {%-
            render 'button-block' with
            wrapper_class: "cart__empty-button",
            link: routes.root_url,
            label: empty_label,
            button_style: "btn--secondary",
            button_alignment: 'center'
          -%}
        </div>

        {% comment %}
          Cart no cookies state
          ---------------------
          Browser cookies are required to use the cart. If cookies aren't enabled in the
          browser a message is displayed prompting the user to enable them.
        {% endcomment %}
        <div class="supports-no-cookies">
          <p>{{ 'cart.general.cookies_required' | t }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
// Gift Wrapping

const giftWrappingSelects = document.querySelectorAll('.cart__form-item-gift-wrapping-select');

giftWrappingSelects.forEach(giftWrappingSelect => {
  giftWrappingSelect.addEventListener('change', async function() {
    const wrappingVariantId = giftWrappingSelect.value;
    const wrappingBarcode = giftWrappingSelect.dataset.giftWrappingBarcode;
    const itemVariantId = giftWrappingSelect.dataset.giftWrappingVariantId;
    const itemQuantity = giftWrappingSelect.dataset.giftWrappingQuantity;

    giftWrappingSelect.classList.add('loading');

    if (!wrappingVariantId) {
      try {
        const cartResponse = await fetch('/cart.js');
        if (!cartResponse.ok) throw new Error('Failed to fetch cart');
        const cart = await cartResponse.json();

        const wrappingLine = cart.items.find(item => {
          return item.properties && String(item.properties.wrapped_item) === String(itemVariantId);
        });

        if (wrappingLine) {
          const removeResponse = await fetch('/cart/change.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({
              id: wrappingLine.key,
              quantity: 0
            }),
          });

          if (!removeResponse.ok) throw new Error('Failed to remove gift wrapping');
          location.reload();
        }
      } catch (error) {
        console.error('Error removing gift wrapping:', error);
      } finally {
        giftWrappingSelect.classList.remove('loading');
      }
      return;
    }

    try {
      if (!wrappingBarcode) throw new Error('Missing wrapping barcode for selected wrapping variant');

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          id: wrappingVariantId,
          quantity: itemQuantity,
          properties: {
            wrapped_item: itemVariantId,
            wrapping_barcode: wrappingBarcode
          }
        }),
      });

      if (!response.ok) throw new Error('Failed to add gift wrapping to cart');

      location.reload();
    } catch (error) {
      console.error('Error adding gift wrapping:', error);
    } finally {
      giftWrappingSelect.classList.remove('loading');
    }
  });
});

// Remove Gift Item Style
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[data-remove-item]').forEach(button => {
    button.addEventListener('click', function () {
      const cartItem = button.closest('[data-input-item]');
      if (cartItem && cartItem.classList.contains('cart__form-item--gift')) {
        cartItem.style.opacity = '0.5';
      }
    });
  });
});
</script>

<script type="text/javascript">
// karte cart
try {
  let items = [];
  {% for line_item in cart.items %}
  items.push({
    id: "{{line_item.sku}}",
    name: "{{line_item.title}}",
    quantity: "{{line_item.quantity}}" ? Number("{{line_item.quantity}}") : null,
    I_category_name: "{{line_item.product.type}}",
    vendor: "{{line_item.vendor}}",
    price: "{{line_item.final_price}}" ? Number("{{line_item.final_price}}")/100 : null,
    item_url: "{{line_item.url}}",
    item_image_url: {{line_item.image | image_url: width: 1200 | json}},
  });
  {% endfor %}

  const item_names = items.map((item) => item.name);
  const item_prices = items.map((item) => item.price);

  krt("send", "cart", {
    items: items,
    item_names: item_names,
    item_prices: item_prices,
    Price: "{{cart.total_price}}" ? Number("{{cart.total_price}}")/100 : null,
    status: "{{cart.item_count}}" ? Number("{{cart.item_count}}")>0 : null,
  });
} catch(e) {
  if ("krt" in window) {
    krt("send", "_error", { message: e.message });
  } else {
    console.warn("tracker was not loaded");
  }
}
</script>

