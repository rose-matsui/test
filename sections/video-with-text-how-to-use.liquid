{% comment %} 
  This section is a custom version of the video-with-text section that uses the product metafield "how_to_use" to populate the content. 
  It is designed to be used on product pages and will only render if the metafield is not blank.
  Additionally, it includes logic to handle also the image-with-text version of the section if the desktop media is an image instead of a video.
{% endcomment %}

{% if product.metafields.custom.how_to_use.value != blank %}
{%- liquid
  assign placeholder_aspect_ratio = section.settings.aspect_ratio
  assign how_to_use_metafield = product.metafields.custom.how_to_use.value
  assign how_to_use_media_desktop = how_to_use_metafield.video_or_image_desktop.value
  assign how_to_use_media_mobile = how_to_use_metafield.video_or_image_mobile.value

  comment
    Determine media types for desktop and mobile
  endcomment

  assign desktop_media_type = ''
  if how_to_use_media_desktop != blank
    assign desktop_media_type = how_to_use_media_desktop.media_type
  endif

  assign mobile_media_type = ''
  if how_to_use_media_mobile != blank
    assign mobile_media_type = how_to_use_media_mobile.media_type
  endif

  assign render_image_markup = false
  if desktop_media_type == 'image'
    assign render_image_markup = true
  endif

  comment
    Main video-with-text section logic
  endcomment

  capture video_placeholder_html
    render 'image', wrapper_class: 'video-with-text__image', sizes: '1800x', include_placeholder: true, placeholder_natural_fallback_ratio: placeholder_aspect_ratio, placeholder_name: 'lifestyle-2', animate: true
  endcapture

  assign has_video = false
  if desktop_media_type == 'video'
    assign has_video = true
    assign video_html = how_to_use_media_desktop | video_tag: image_size: '1800x', class: 'video-with-text__video animation--video-with-text', autoplay: true, loop: true, muted: true, controls: false
  else
    assign video_html = video_placeholder_html
  endif

  assign has_mobile_video = false
  if mobile_media_type == 'video'
    assign has_mobile_video = true
    assign video_html_mobile = how_to_use_media_mobile | video_tag: image_size: '720x', class: 'video-with-text__video video-with-text__video--mobile animation--video-with-text', autoplay: true, loop: true, muted: true, controls: false
  endif

  if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)'
    assign has_background_color = true
  endif

  comment
    Specific image-with-text section logic
  endcomment

  assign show_animations = false
  if settings.enable_section_animations and section.settings.enable_animation
    assign show_animations = true
  endif

-%}
{%- capture section_classes -%}
  section {{ section.settings.section_padding }} {% if section.settings.full_width %}section--full-width{% endif %}
{%- endcapture -%}

{% comment %} Image with text section {% endcomment %}
{% if render_image_markup %}
<div
  class="
    image-with-text
    image-with-text--justify-{{ section.settings.image_text_alignment }}
    image-with-text--image-{{ section.settings.image_position }}
    {% unless has_background_color %}
      {{ section_classes }}
    {% endunless %}
    {% if show_animations %}
      animation
      animation--image-with-text
    {% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="image-with-text"
  style="
    --sbn-background-color: {{ section.settings.background_color }};
    --section-background-color: ;
    --color-text: {{ section.settings.text_color }};
    --color-text-alpha-60: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
    --color-text-link: {{ section.settings.text_color }};
    --text-alignment: {{ section.settings.image_text_alignment }};
    --small-image-placeholder-color: {{ settings.color_text | color_modify: 'alpha', 0.7 }};
    {% render 'overlay-button-vars' with color_button_text: section.settings.button_text_color, color_button_background: section.settings.button_background_color %}

    {% if section.settings.image_adaptive_height == false %}
      --sbn-aspect-ratio: {%- case section.settings.image_aspect_ratio -%}
        {%- when "portrait" -%}0.667
        {%- when "landscape" -%}1.5
        {%- when "square" -%}1
        {%- else -%}1
      {%- endcase -%};
    {% endif %}
  "
>
  <div
    class="
      image-with-text__inner
      {% if has_background_color %}
        {{ section_classes }}
      {% endif %}
    "
  >
    <div class="image-with-text__content">
      <div class="image-with-text__image-container">
        <div class="image-with-text__image-container-inner">
          <figure class="image-with-text__image-wrapper">
            {%-
              render 'image' with
              wrapper_class: "image-with-text__image",
              image: how_to_use_media_desktop,
              sizes: '(min-width: 720px) calc(50vw - clamp(18px, 3.3vw, 3.3vw)), calc(100vw - 80px)',
              aspect_ratio: section.settings.image_aspect_ratio,
              focal_point: section.settings.image_focal_point,
              include_placeholder: true,
              animate: show_animations
            -%}
          </figure>
        </div>
      </div>

      <div class="image-with-text__text-container">
        <div
          class="
            image-with-text__text-container-inner
            section-blocks
            {% if show_animations %}animation--section-blocks{% endif %}
          "
        >
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'accent' -%}
                {%- unless block.settings.accent == blank -%}
                  <p class="image-with-text__text-container-accent fs-accent section-blocks__accent">
                    {{ block.settings.accent }}
                  </p>
                {%- endunless -%}
              {%- when 'heading' -%}
                {%- unless block.settings.title == blank -%}
                  <{{ block.settings.heading_tag }} class="image-with-text__text-container-heading ff-heading {{ block.settings.heading_font_class }} section-blocks__heading" style="--color-text: {{ section.settings.heading_color }}; color: var(--color-text);">
                    {{ block.settings.title }}
                  </{{ block.settings.heading_tag }}>
                {%- endunless -%}
              {%- when 'subheading' -%}
                {%- unless block.settings.subheading == blank -%}
                  <{{ block.settings.subheading_tag }} class="image-with-text__text-container-subheading ff-subheading {{ block.settings.subheading_font_class }} section-blocks__subheading" style="--color-text: {{ section.settings.heading_color }}; color: var(--color-text);">
                    {{ block.settings.subheading }}
                  </{{ block.settings.subheading_tag }}>
                {%- endunless -%}
              {%- when 'text' -%}
                {%- unless block.settings.text == blank -%}
                  <div class="image-with-text__text-container-text rte ff-body {{ block.settings.text_font_class }} section-blocks__text">
                    {{ block.settings.text }}
                  </div>
                {%- endunless -%}
              {%- when 'image' -%}
                {%-
                  render 'image-block' with
                  shopify_attributes: block.shopify_attributes,
                  wrapper_class: 'image-with-text__text-container-image section-blocks__image  section-blocks__image',
                  image: block.settings.image,
                  width: block.settings.image_size,
                  mobile_width: block.settings.image_size_mobile,
                  break_to_mobile_at: '720',
                  align: section.settings.image_text_alignment
                -%}
              {%- when 'button' -%}
                {%-
                  render 'button-block' with
                  wrapper_class: "image-with-text__text-container-button section-blocks__button",
                  link: block.settings.link,
                  label: block.settings.link_text,
                  button_style: block.settings.button_style,
                  is_overlay: true,
                  button_alignment: section.settings.image_text_alignment,
                  buttons_can_inline: true,
                  forloop: forloop
                -%}
              {%- when 'play-button' -%}
                {%-
                  render 'play-button-block' with
                  wrapper_class: 'image-with-text__text-container-play-button section-blocks__video-button',
                  block: block,
                  button_alignment: section.settings.image_text_alignment
                -%}
              {%- when 'border' -%}
                {%- render 'border-block' -%}
              {%- when 'spacer' -%}
                {%- render 'spacer-block' with space: block.settings.space -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% else %}
{% comment %} Video with text section {% endcomment %}
<div
  class="
    video-with-text
    video-with-text--video-position-{{ section.settings.video_position }}
    video-with-text--video-mobile-position-above-content
    video-with-text--content-align-{{ section.settings.content_alignment }}
    video-with-text--aspect-ratio-{{ section.settings.aspect_ratio }}
    video-with-text--aspect-ratio-mobile-{{ section.settings.aspect_ratio_mobile }}
    {% if has_video -%}
      video-with-text--has-video
    {%- elsif has_mobile_video == true -%}
      video-with-text--has-mobile-video-only
    {%- endif %}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--video-with-text
    {% endif %}
    {% unless has_background_color %}
      {{ section_classes }}
    {% endunless %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="video-with-text"
  style="
    --sbn-background-color: {{ section.settings.background_color }};
    --color-background: ;
    --color-text: {{ section.settings.text_color }};
    --color-text-link: {{ section.settings.text_color }};
    --text-align: {{ section.settings.content_alignment }};
    --video-focal-alignment-horizontal: {{ section.settings.focal_point }};
    --video-focal-alignment-horizontal-mobile: {{ section.settings.focal_point_mobile }};
    {% render 'overlay-button-vars' with color_button_text: section.settings.button_text_color, color_button_background: section.settings.button_background_color %}
  "
>
  <div class="
    video-with-text__inner
    {% if has_background_color %}
      {{ section_classes }}
    {% endif %}
  ">
    <div
      class="video-with-text__media-container"
      data-video-loading="false"
      data-has-video="{{ has_video }}"
      data-has-mobile-video="{{ has_mobile_video }}"

      {% # Loading background images prevents loading jump when size specified with height or aspect ratio %}
      style="
        {% if has_video %}
          --video-preview-image: url({{ how_to_use_media_desktop.preview_image | image_url }});
        {% endif %}
        {% if has_mobile_video %}
          --video-preview-image-mobile: url({{ how_to_use_media_mobile.preview_image | image_url }});
        {% endif %}
      "
    >
      {%- if has_video or has_mobile_video -%}
        <div class="video-with-text__video-wrapper">
          {% # Using templates prevents multiple videos loading at once {% endcomment %}
          <template id="mobile-video-with-text-template">
            {{ video_html_mobile }}
          </template>
          <template id="default-video-with-text-template">
            {{ video_html }}
          </template>

          <div class="current-video-with-text-container"></div>

          {% render 'video-pause' %}
        </div>
      {%- else -%}
        {% # ensure placeholder only shows when no video %}
        {{ video_placeholder_html }}
      {%- endif -%}
    </div>

    <div class="video-with-text__text-container">
      <div class="video-with-text__text-container-inner section-blocks animation--section-blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'accent' -%}
              {%- unless block.settings.accent == blank -%}
                <p class="video-with-text__text-container-accent fs-accent section-blocks__accent">
                  {{ block.settings.accent }}
                </p>
              {%- endunless -%}
            {%- when 'heading' -%}
              {%- unless block.settings.title == blank -%}
                <{{ block.settings.heading_tag }} class="video-with-text__text-container-heading ff-heading {{ block.settings.heading_font_class }} section-blocks__heading" style="--color-text: {{ section.settings.heading_color }}; color: var(--color-text);">
                  {{ block.settings.title }}
                </{{ block.settings.heading_tag }}>
              {%- endunless -%}
            {%- when 'subheading' -%}
              {%- unless block.settings.subheading == blank -%}
                <{{ block.settings.subheading_tag }} class="video-with-text__text-container-subheading ff-subheading {{ block.settings.subheading_font_class }} section-blocks__subheading" style="--color-text: {{ section.settings.heading_color }}; color: var(--color-text);">
                  {{ block.settings.subheading }}
                </{{ block.settings.subheading_tag }}>
              {%- endunless -%}
            {%- when 'text' -%}
              {%- unless block.settings.text == blank -%}
                <div class="video-with-text__text-container-text rte ff-body {{ block.settings.text_font_class }} section-blocks__text">
                  {{ block.settings.text }}
                </div>
              {%- endunless -%}
            {%- when 'button' -%}
              {%- render 'button-block',
                wrapper_class: 'video-with-text__text-container-text-button section-blocks__button',
                link: block.settings.link,
                label: block.settings.link_text,
                button_style: block.settings.button_style,
                is_overlay: true,
                buttons_can_inline: true,
                button_alignment: section.settings.content_alignment,
                forloop: forloop
              -%}
            {%- when 'image' -%}
              {%-
                render 'image-block',
                shopify_attributes: block.shopify_attributes,
                wrapper_class: 'video-with-text__text-container-image  section-blocks__image',
                image: block.settings.image,
                width: block.settings.image_size,
                mobile_width: block.settings.image_size_mobile,
                break_to_mobile_at: '480',
                align: section.settings.content_alignment
              -%}
            {%- when 'play-button' -%}
              {%- render 'play-button-block',
                wrapper_class: 'video-with-text__text-container-text-play-button section-blocks__video-button',
                block: block,
                button_alignment: section.settings.content_alignment,
              -%}
            {%- when 'border' -%}
              {%- render 'border-block' -%}
            {%- when 'spacer' -%}
              {%- render 'spacer-block', space: block.settings.space -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% endif %}
{% endif %}

{% schema %}
{
  "name": "How To Use - Media&Text",
  "tag": "section",
  "class": "shopify-section--full-width sbn-custom",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:sections.video_with_text.settings.video_position.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.video_with_text.settings.video_position.option_left"
        },
        {
          "value": "right",
          "label": "t:sections.video_with_text.settings.video_position.option_right"
        }
      ]
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:sections.video_with_text.settings.video_aspect_ratio.label",
      "default": "landscape",
      "options": [
        {
          "label": "t:shared.settings.aspect_ratio.option_portrait",
          "value": "portrait"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_square",
          "value": "square"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_landscape",
          "value": "landscape"
        }
      ]
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "t:sections.video_with_text.settings.video_aspect_ratio_mobile.label",
      "default": "landscape",
      "options": [
        {
          "value": "natural",
          "label": "t:shared.settings.aspect_ratio.option_natural"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_portrait",
          "value": "portrait"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_portrait_alt",
          "value": "portrait_alt"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_square",
          "value": "square"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_landscape_alt",
          "value": "landscape_alt"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_landscape",
          "value": "landscape"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_landscape_wide_alt",
          "value": "landscape_wide_alt"
        },
        {
          "label": "t:shared.settings.aspect_ratio.option_landscape_ultrawide_alt",
          "value": "landscape_ultrawide_alt"
        }
      ]
    },
    {
      "id": "focal_point",
      "type": "select",
      "label": "t:sections.video_with_text.settings.focal_point.label",
      "options": [
        {
          "label": "t:shared.settings.focal_point.option_left",
          "value": "left"
        },
        {
          "label": "t:shared.settings.focal_point.option_center",
          "value": "center"
        },
        {
          "label": "t:shared.settings.focal_point.option_right",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "id": "focal_point_mobile",
      "type": "select",
      "label": "t:sections.video_with_text.settings.focal_point_mobile.label",
      "options": [
        {
          "label": "t:shared.settings.focal_point.option_left",
          "value": "left"
        },
        {
          "label": "t:shared.settings.focal_point.option_center",
          "value": "center"
        },
        {
          "label": "t:shared.settings.focal_point.option_right",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_with_text.settings.image_position.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image_with_text.settings.image_position.option_left"
        },
        {
          "value": "right",
          "label": "t:sections.image_with_text.settings.image_position.option_right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_text_alignment",
      "label": "t:sections.image_with_text.settings.text_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:shared.settings.alignment_horizontal.option_left"
        },
        {
          "value": "center",
          "label": "t:shared.settings.alignment_horizontal.option_center"
        },
        {
          "value": "right",
          "label": "t:shared.settings.alignment_horizontal.option_right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "t:shared.settings.aspect_ratio.label",
      "default": "landscape",
      "options": [
        {
          "value": "square",
          "label": "t:shared.settings.aspect_ratio.option_square"
        },
        {
          "value": "portrait",
          "label": "t:shared.settings.aspect_ratio.option_portrait"
        },
        {
          "value": "landscape",
          "label": "t:shared.settings.aspect_ratio.option_landscape"
        }
      ]
    },
    {
      "id": "image_adaptive_height",
      "type": "checkbox",
      "label": "Adaptive height (Desktop)",
      "default": true
    },
    {
      "id": "image_focal_point",
      "type": "select",
      "label": "t:shared.settings.focal_point.label",
      "options": [
        {
          "label": "t:shared.settings.focal_point.option_image",
          "value": "image_presentation"
        },
        {
          "label": "t:shared.settings.focal_point.option_center",
          "value": "center"
        },
        {
          "label": "t:shared.settings.focal_point.option_top",
          "value": "top"
        },
        {
          "label": "t:shared.settings.focal_point.option_bottom",
          "value": "bottom"
        },
        {
          "label": "t:shared.settings.focal_point.option_left",
          "value": "left"
        },
        {
          "label": "t:shared.settings.focal_point.option_right",
          "value": "right"
        }
      ],
      "default": "image_presentation"
    },
    {
      "type": "header",
      "content": "t:sections.video_with_text.settings.header__content.content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.image_with_text_split.settings.content_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:shared.settings.alignment_horizontal.option_left"
        },
        {
          "value": "center",
          "label": "t:shared.settings.alignment_horizontal.option_center"
        },
        {
          "value": "right",
          "label": "t:shared.settings.alignment_horizontal.option_right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:shared.settings.header_color.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:shared.settings.background_color.label",
      "default": "#FFFEF9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & Subheading Color",
      "default": "#b4975e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:shared.settings.buttons_background_color.label",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:shared.settings.button_text_color.label",
      "default": "#FFFEF9"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header_style.content"
    },
    {
      "id": "enable_animation",
      "type": "checkbox",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "info": "t:shared.settings.section_style.enable_animation.info",
      "default": true
    },
    {
      "id": "full_width",
      "type": "checkbox",
      "label": "t:shared.settings.section_style.full_width.label",
      "default": false
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "t:shared.settings.section_style.section_padding.label",
      "default": "section--vertical-padding-none",
      "options": [
        {
          "label": "t:shared.settings.section_style.section_padding.option_none", "value": "section--vertical-padding-none"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_both", "value": "section--vertical-padding-top-bottom"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_top", "value": "section--vertical-padding-top-only"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_bottom", "value": "section--vertical-padding-bottom-only"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "accent",
      "name": "t:sections.video_with_text.blocks.accent.name",
      "settings": [
        {
          "id": "accent",
          "type": "text",
          "label": "t:sections.video_with_text.blocks.accent.settings.text.label",
          "default": "Accent"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.video_with_text.blocks.title.name",
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "t:sections.video_with_text.blocks.title.settings.title.label",
          "default": "ご使用方法"
        },
        {
