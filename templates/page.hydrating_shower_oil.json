cal-padding-bottom-only","content_width":"full","custom_content_width":700}},"rich_text_pbxwYk":{"type":"rich-text","blocks":{"heading_FmcXwN":{"type":"heading","settings":{"title":"Story","heading_tag":"h2","heading_font_class":"fs-heading-1-base","text_color":"#212121"}},"image_qqFjTy":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/hso_name.png","content_width":"custom","forced_image_alignment":true,"image_size":400,"image_size_mobile":350}},"subheading_8HTcyy":{"type":"subheading","disabled":true,"settings":{"subheading":"心まで透き通る「泡潤リチュアル」は、人生の喜びともなる、いのちの浄化","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"text_z7rp3G":{"type":"text","disabled":true,"settings":{"text":"<p>洗うことの至福をここまで丁寧に追い求めた製品があったでしょうか。<br\/>25年目の進化は\"美容オイルで洗う\"ことへの情熱の高まりから、バスタイムを\"ケアと癒し\"を高次元で融合した思いがけない時間に変えました。<br\/>泡を着て、泡と戯れ、泡で潤し、時にはそのままバスタブに体を沈めて泡風呂へ……「泡潤リチュアル」はそれが入浴であることすら忘れさせてしまう甘美なる時空。<br\/>シャワーオイルがなぜ唯一無二なのかを感性と肌に訴えかけます。<br\/>香りはどれも独創的なのに、心身を浄化し昇華させ、えも言われぬ夢想世界へ誘うのです。<br\/>それは、体験しないとわからない未知なる快感。<br\/>きっとこの没入体験の驚きと感動を誰かに伝えたいとの衝動にも駆られるはず。<br\/>だからぜひギフトにも。「私」を深く癒す新習慣を大切な人に贈り、分かち合うこと、それ自体もう1つの喜び。<br\/>\"洗う魔法\"で毎日毎日全身を幸福感で満たし続けるのは、人生の掛け替えのない喜びに違いないのですから。<br\/><br\/><\/p>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["heading_FmcXwN","image_qqFjTy","subheading_8HTcyy","text_z7rp3G"],"custom_css":[],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-bottom-only","content_width":"custom","custom_content_width":700}},"collapsible_row_list_rd8c3n":{"type":"collapsible-row-list","blocks":{"item_KWGXtg":{"type":"item","settings":{"expand_by_default":false,"icon":"none","title":"心まで透き通る「泡潤リチュアル」は、人生の喜びともなる、いのちの浄化","text":"<p>洗うことの至福をここまで丁寧に追い求めた製品があったでしょうか。<br\/>25年目の進化は\"美容オイルで洗う\"ことへの情熱の高まりから、バスタイムを\"ケアと癒し\"を高次元で融合した思いがけない時間に変えました。<br\/>泡を着て、泡と戯れ、泡で潤し、時にはそのままバスタブに体を沈めて泡風呂へ……「泡潤リチュアル」はそれが入浴であることすら忘れさせてしまう甘美なる時空。<br\/>シャワーオイルがなぜ唯一無二なのかを感性と肌に訴えかけます。<br\/>香りはどれも独創的なのに、心身を浄化し昇華させ、えも言われぬ夢想世界へ誘うのです。<br\/>それは、体験しないとわからない未知なる快感。<br\/>きっとこの没入体験の驚きと感動を誰かに伝えたいとの衝動にも駆られるはず。<br\/>だからぜひギフトにも。「私」を深く癒す新習慣を大切な人に贈り、分かち合うこと、それ自体もう1つの喜び。<br\/>\"洗う魔法\"で毎日毎日全身を幸福感で満たし続けるのは、人生の掛け替えのない喜びに違いないのですから。<br\/><br\/><\/p>","content_width":"custom","image_size":200,"image_size_mobile":200}}},"block_order":["item_KWGXtg"],"name":"t:sections.collapsible_row_list.presets.name","settings":{"title":"","heading_anchor_id":"","heading_tag":"h2","heading_font_class":"fs-heading-3-base","subheading":"","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base","heading_alignment":"left","item_heading_font":"heading","enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-bottom-only","content_width":"custom","custom_content_width":700}},"rich_text_HBe7UF":{"type":"rich-text","blocks":{"heading_bPwtQU":{"type":"heading","settings":{"title":"How to Use","heading_tag":"h2","heading_font_class":"fs-heading-2-base","text_color":"#212121"}},"subheading_VidfkY":{"type":"subheading","settings":{"subheading":"オイルと泡が誘う夢想世界で「私」を潤す新習慣を","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}}},"block_order":["heading_bPwtQU","subheading_VidfkY"],"custom_css":["h2,h3,h4,h5,h6 {font-family: \"游明朝\", YuMincho, \"ヒラギノ明朝 ProN\", \"Hiragino Mincho ProN\", \"MS 明朝\", \"MS P明朝\", serif;}"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_center","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-bottom-only","content_width":"custom","custom_content_width":700}},"multi_column_mVErct":{"type":"multi-column","blocks":{"image_column_8VtbX9":{"type":"image_column","settings":{"image":"shopify:\/\/shop_images\/hso_step1.jpg","image_width":100,"aspect_ratio":"natural","enable_image_crop_circle":false,"focal_point":"image_presentation","image_position":"above_text","image_link":"","small_caption":"","accent":"step 1","heading":"美容液オイルでなであげる","heading_tag":"h3","heading_font_class":"fs-heading-4-base","text":"<p>オイルをてのひらにとって、身体の中心に向かって引き上げるようになじませ、一度洗い流す。<br\/><strong>［推奨使用量］<br\/><\/strong>上半身２プッシュ（腕１本１プッシュ：指先から肩に向かって）<br\/>下半身２プッシュ（脚１本１プッシュ：つま先からふくらはぎ・太ももに向かって）<br\/><br\/><\/p>","text_font_class":"fs-body-75","text_max_width":100,"link":"\/collections\/DelicateJasmine\/","link_text":"","button_style":"btn--callout"}},"image_column_LDmHxc":{"type":"image_column","settings":{"image":"shopify:\/\/shop_images\/hso_step2.jpg","image_width":100,"aspect_ratio":"natural","enable_image_crop_circle":false,"focal_point":"image_presentation","image_position":"above_text","image_link":"","small_caption":"","accent":"step 2","heading":"泡を纏う","heading_tag":"h3","heading_font_class":"fs-heading-4-base","text":"<p>水と空気を含ませた濃密泡をてのひらにとって、３秒香りを深呼吸。<br\/>その泡をつぶさないようにやさしく円を描きながら肌をマッサージし軽やかに毛穴汚れを落としながら潤いを与える。<br\/><br\/><\/p>","text_font_class":"fs-body-100","text_max_width":100,"link":"","link_text":"","button_style":"btn--callout"}},"image_column_VbDa9c":{"type":"image_column","settings":{"image":"shopify:\/\/shop_images\/hso_step3.jpg","image_width":100,"aspect_ratio":"natural","enable_image_crop_circle":false,"focal_point":"image_presentation","image_position":"above_text","image_link":"","small_caption":"","accent":"step 3","heading":"泡風呂を楽しむ","heading_tag":"h3","heading_font_class":"fs-heading-4-base","text":"<p>濃密泡をまとったままバスタブのお湯に身体を沈め、香りと泡に包まれて心までリフレッシュする。<\/p>","text_font_class":"fs-body-100","text_max_width":100,"link":"","link_text":"","button_style":"btn--callout"}}},"block_order":["image_column_8VtbX9","image_column_LDmHxc","image_column_VbDa9c"],"custom_css":["h2,h3,h4,h5,h6 {font-family: \"游明朝\", YuMincho, \"ヒラギノ明朝 ProN\", \"Hiragino Mincho ProN\", \"MS 明朝\", \"MS P明朝\", serif;}"],"name":"t:sections.multi_column.presets.name","settings":{"title":"","heading_tag":"h2","subheading":"","heading_font_class":"fs-heading-3-base","heading_alignment":"center","content_vertical_alig