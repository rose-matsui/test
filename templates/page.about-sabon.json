    "image_with_text_sbn_custom_7iTMAX": {
      "type": "image-with-text-sbn-custom",
      "blocks": {
        "heading_t7a4md": {
          "type": "heading",
          "settings": {
            "title": "喜びを分かち合う贈り物",
            "heading_tag": "h2",
