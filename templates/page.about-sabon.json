    "image_with_text_sbn_custom_ixpiAF": {
      "type": "image-with-text-sbn-custom",
      "blocks": {
        "heading_dmmhef": {
          "type": "heading",
          "settings": {
            "title": "渇きを癒す、死海と植物",
