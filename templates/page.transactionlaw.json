xt.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_gVLimN":{"type":"rich-text","blocks":{"subheading_DfHT7k":{"type":"subheading","settings":{"subheading":"販売価格","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_qatAkg":{"type":"border","settings":{}},"text_Dpqheg":{"type":"text","settings":{"text":"<p>各商品ページに表示された税込価格に基づきます。<\/p>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_DfHT7k","border_qatAkg","text_Dpqheg"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_tP9XGW":{"type":"rich-text","blocks":{"subheading_tcGRPY":{"type":"subheading","settings":{"subheading":"商品代金以外の必要料金","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_BCEQxU":{"type":"border","settings":{}},"text_J6iCHP":{"type":"text","settings":{"text":"<ul><li>配送料<br\/>商品の合計代金が6,000円（税込）以上の場合・・・無料<br\/>商品の合計代金が5,999円（税込）以下の場合・・・全国一律550円（税込）<br\/>※沖縄県は1,140円（税込）<\/li><li>あと払い（Paidy）手数料<br\/>あと払い（Paidy）をご利用の場合、お支払い方法により所定の手数料が発生する場合がございます。<br\/>手数料の詳細は「<a href=\"https:\/\/cs-support.paidy.com\/support\/solutions\/articles\/150000040596-%E6%89%8B%E6%95%B0%E6%96%99%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%E7%9F%A5%E3%82%8A%E3%81%9F%E3%81%84\" title=\"https:\/\/cs-support.paidy.com\/support\/solutions\/articles\/150000040596-%E6%89%8B%E6%95%B0%E6%96%99%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%E7%9F%A5%E3%82%8A%E3%81%9F%E3%81%84\">Paidy手数料について<\/a>」をご確認ください。<\/li><\/ul>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_tcGRPY","border_BCEQxU","text_J6iCHP"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_frYRh4":{"type":"rich-text","blocks":{"subheading_7MH76c":{"type":"subheading","settings":{"subheading":"支払方法","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_YYhgEU":{"type":"border","settings":{}},"text_wGWHmi":{"type":"text","settings":{"text":"<ul><li>クレジットカード（Visa\/Mastercard\/JCB\/Amex\/Diners）<\/li><li>PayPay<\/li><li>楽天ペイ<\/li><li>Paidy（ペイディ）<\/li><\/ul>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_7MH76c","border_YYhgEU","text_wGWHmi"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_j884KL":{"type":"rich-text","blocks":{"subheading_ebfhkP":{"type":"subheading","settings":{"subheading":"支払期限","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_EFkJnN":{"type":"border","settings":{}},"text_bzDn67":{"type":"text","settings":{"text":"<ul><li>クレジットカード<br\/>ご注文後、即時決済となります。<br\/>カード会社の締め日等により、請求が1～2ヶ月先になる場合がございます。<br\/>詳しくは、ご利用のカード会社の明細書をご確認ください。<\/li><li>Pay Pay<br\/>ご注文後、即時決済となります。<br\/>商品購入時にPayPayの決済画面へ遷移します。<br\/>画面の案内に従ってお支払い手続きをお願いいたします。<\/li><li>楽天ペイ<br\/>ご注文後、即時決済となります。<br\/>商品購入時に楽天ペイの決済画面へ遷移します。<br\/>画面の案内に従ってお支払い手続きをお願いいたします。<\/li><li>Paidy（ペイディ）<br\/>ご注文月の翌月27日がお支払期限となります。<br\/>商品購入時にPaidy（ペイディ）の決済画面へ遷移します。<br\/>画面の案内に従ってお支払い手続きをお願いいたします。<\/li><\/ul>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_ebfhkP","border_EFkJnN","text_bzDn67"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_zaU9c4":{"type":"rich-text","blocks":{"subheading_CTmK7G":{"type":"subheading","settings":{"subheading":"引き渡し時期","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_wK6VFf":{"type":"border","settings":{}},"text_Ptyqh6":{"type":"text","settings":{"text":"<p>ご注文確定後、原則として7日以内に発送いたします。<br\/>ただし、配送地域、交通事情、天候、繁忙期、在庫状況等により、お届けまでに通常よりお時間をいただく場合がございます。<br\/>予約商品、入荷待ち商品、販売期間限定商品等については、各商品ページに記載の発送予定時期に従います。<\/p>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_CTmK7G","border_wK6VFf","text_Ptyqh6"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_8gKB4T":{"type":"rich-text","blocks":{"subheading_CFEbaU":{"type":"subheading","settings":{"subheading":"販売数量の制限・特別な販売条件","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_MFYxac":{"type":"border","settings":{}},"text_JpDiQq":{"type":"text","settings":{"text":"<p>商品により、販売数量、販売期間、購入条件を設ける場合がございます。<br\/>その場合は、各商品ページまたはキャンペーンページに表示いたします。<\/p>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_CFEbaU","border_MFYxac","text_JpDiQq"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_LXXkYV":{"type":"rich-text","blocks":{"subheading_DrmwCy":{"type":"subheading","settings":{"subheading":"返品・交換・キャンセル等","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_MDMJdY":{"type":"border","settings":{}},"text_3fjpAk":{"type":"text","settings":{"text":"<p>商品発送後のお客様都合による返品・交換・キャンセルはお受けいたしかねます。<br\/>また、ご注文確定後の内容変更・キャンセルは、出荷準備状況によりお受けできない場合がございます。<br\/><br\/>商品に不具合があった場合、またはご注文内容と異なる商品が届いた場合は、商品到着後10日以内にカスタマーサービスまでご連絡ください。当社にて確認のうえ、交換または返金にて対応いたします。<\/p><p>なお、交換商品の在庫がない場合は、返金にて対応いたします。<br\/>事前のご連絡なく商品をご返送された場合、返品・交換をお受けできない場合がございます。<\/p>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_DrmwCy","border_MDMJdY","text_3fjpAk"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_KeT9Xg":{"type":"rich-text","blocks":{"subheading_ciFPLq":{"type":"subheading","settings":{"subheading":"返品期限","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_WbJQLt":{"type":"border","settings":{}},"text_DTAThK":{"type":"text","settings":{"text":"<p>商品到着後10日以内に、カスタマーサービスまでご連絡ください。<\/p>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_ciFPLq","border_WbJQLt","text_DTAThK"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-only","content_width":"custom","custom_content_width":800}},"rich_text_JYntUe":{"type":"rich-text","blocks":{"subheading_Ng9L7G":{"type":"subheading","settings":{"subheading":"返品送料","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base"}},"border_xWJemr":{"type":"border","settings":{}},"text_YM4Cc7":{"type":"text","settings":{"text":"<p>商品不良、破損、汚損、誤配送など、当社理由による返品・交換の場合は当社が負担いたします。<\/p>","text_font_class":"fs-body-100","align_last":false}}},"block_order":["subheading_Ng9L7G","border_xWJemr","text_YM4Cc7"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_left","enable_animation":true,"divider_style":"none","border":false,"section_padding":"section--vertical-padding-top-bottom","content_width":"custom","custom_content_width