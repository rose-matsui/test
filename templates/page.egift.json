          }
        },
        "text_y4wQD4": {
          "type": "text",
          "settings": {
            "text": "<h3><strong>Wrapping Service</strong></h3><p>ラッピングサービス</p>",
            "text_font_class": "fs-body-75",
            "align_last": false
          }
        },
        "image_Vg9pfF": {
          "type": "image",
