{% assign render_thumbnails = meganav_settings.show_desktop_thumbnails %}

<div
  class="meganav__nav{% if meganav_settings.show_column_borders %} with-column-dividers{% endif %}"
  data-column-count="{{ meganav_settings.column_count }}"
>
  <ul class="meganav__list-parent" depth="0">
    {% for link in link.links %}
      <li class="{% if link.links.size > 0 %} has-children{% endif %}" depth="0">
        <h4>
          <a href="{{ link.url }}">{{ link.title }}</a>
        </h4>
        {% if link.links %}
          <ul depth="1" class="meganav__product-list">
            {% for link in link.links %}
              <li class="meganav__item-level-3">
                {% liquid
                  if render_thumbnails
                    assign resource = link.object
                    assign thumbnail_meganav = blank
  
                    if link.type == 'product_link'
                      assign thumbnail_meganav = resource.featured_image
                    elsif link.type == 'collection_link' and resource.metafields.stiletto.mobile_menu_thumbnail.value != blank
                      assign thumbnail_meganav = resource.metafields.stiletto.mobile_menu_thumbnail.value
                    else
                      
                    endif
                  endif
                %}

                <a data-href="{{ link.url }}" class="meganav-link">
                  {% if render_thumbnails and thumbnail_meganav != blank%}
                    <div class="meganav-thumbnail" style="--thumbnail-width:50px">
                      {% render 'image', image: thumbnail_meganav, aspect_ratio: 'square', sizes: '50px', src_set_type: 'thumbnail' %}
                    </div>
                  {% endif %}
                  <span class="meganav-title">
                    {{ link.title }}
                  </span>
                </a>
              </li>
            {% endfor %}
          </ul>
          {% render 'navigation-data-href', selector: '.meganav__product-list a[data-href]' %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
  {% assign dividers_needed = meganav_settings.column_count | minus: 1 %}
  {%- for i in (1..dividers_needed) -%}
    <span class="meganav__column-rule" data-index="{{ forloop.index }}"></span>
  {%- endfor -%}
</div>
